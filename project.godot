config_version=5

[GD-Sync]

version="0.13"
publicKey="6393730a42b38db3"
privateKey="de82a27d4ce5994f"

[ambientcg]

extract_path="res://AmbientCG/Extracted"
material_file_directory="res://AmbientCG/Materials"
environment_file_directory="res://AmbientCG/Environments"

[animation]

warnings/check_invalid_track_paths=false
warnings/check_angle_interpolation_type_conflicting=false
compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Rooms"
run/main_scene="uid://cqow47bch5ocs"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://c60bb1213ohd"

[audio]

buses/default_bus_layout="uid://d0ujqgyysbdwl"
driver/enable_input=true

[autoload]

data="*uid://sdeh14euxnht"
ModLoader="*uid://h02p7y6au54x"
MoonwaveDataFormat="*uid://cmqg6dj0a0obb"
ProximityPromptManager="*uid://ce1pxx0gi2ybe"
LobbyManager="*uid://cmqdyweogpbb8"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Rooms"

[editor_plugins]

enabled=PackedStringArray("res://addons/kanban_tasks/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

player=""
cat=""
painting=""
interactors=""
eye_monster=""

